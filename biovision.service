[Unit]
Description=BioVision AI Clinical Wound Assessment Platform
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/BIOVISION-AI
Environment="PATH=/home/ubuntu/BIOVISION-AI/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/ubuntu/BIOVISION-AI/.venv/bin/streamlit run app.py --server.address=0.0.0.0 --server.port=8501 --server.headless=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
